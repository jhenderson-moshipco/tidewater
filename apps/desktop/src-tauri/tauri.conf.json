{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tidewater",
  "version": "../package.json",
  "identifier": "org.tidewater.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tidewater",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../../assets/icons/app/32x32.png",
      "../../../assets/icons/app/128x128.png",
      "../../../assets/icons/app/128x128@2x.png",
      "../../../assets/icons/app/icon.icns",
      "../../../assets/icons/app/icon.ico"
    ]
  }
}
